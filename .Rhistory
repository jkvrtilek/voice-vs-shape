# t-test
voice <- percent_LD1s %>%
mutate(diff = familiar - never_met) %>%
filter(measure %in% red)
t.test(voice$diff)
shape <- percent_LD1s %>%
mutate(diff = familiar - never_met) %>%
filter(measure %in% green)
t.test(shape$diff)
